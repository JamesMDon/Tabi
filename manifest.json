{
  "manifest_version": 3,
  "name": "Tabi",
  "description": "Instantly de-duplicate, merge, & sort tabs.",
  "version": "1.4.0",
  "homepage_url": "https://github.com/JamesMDon/Tabi",
  "incognito": "spanning",
  "icons": {
    "16": "icons/Tabi16.png",
    "32": "icons/Tabi32.png",
    "48": "icons/Tabi48.png",
    "128": "icons/Tabi128.png"
  },
  "action": {
    "default_icon": {
      "16": "icons/Tabi16.png",
      "32": "icons/Tabi32.png"
    }
  },
  "permissions": ["tabs"],
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+T",
        "mac": "Alt+T"
      },
      "description": "Tidy tabs"
    }
  },
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  }
}
